# Copy to .env and fill in. Never commit .env.

# --- Text generation provider ---
# gemini | groq | openai_compatible
LLM_PROVIDER=groq

# Model id for the chosen provider.
#   groq:   qwen/qwen3.8-27b   (tight answers, reliable tool calls; validated)
#           openai/gpt-oss-120b is also available but over-writes and is slower
#   gemini: gemini-2.0-flash   (20/day on gemini-3.6-flash is too low)
LLM_MODEL=qwen/qwen3.8-27b

# API key for the generation provider. Get a free Groq key at
# https://console.groq.com/keys
GROQ_API_KEY=

# Only for LLM_PROVIDER=openai_compatible (OpenRouter, a local Ollama server, ...)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=

# Reserved output tokens for the tool-calling agent loop. Counts toward provider
# per-minute limits (Groq free tier = 8000 TPM), so keep this modest.
LLM_MAX_OUTPUT_TOKENS=2048

# --- Embeddings ---
# Kept on Gemini's free tier; this quota is separate from text generation.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Retrieval / chunking ---
# Passages for the RAG-only path + gate scope check. Lower = tighter citations
# and fewer tokens per agent turn (see the k-ablation in evaluation/RESULTS.md).
RETRIEVAL_K=3
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SEED=42

# --- Evaluation (only used by `python -m evaluation.run_eval` / .ablation) ---
# The LLM judge for groundedness + answer-similarity. Use a DIFFERENT model
# family than LLM_MODEL so the judge doesn't grade its own output
# (self-preference bias). run_eval scores both axes in ONE call per item.
#   groq + openai/gpt-oss-20b : different family from the qwen generator, works
#     on the standard Groq key -- the practical default.
#   gemini + gemini-3.6-flash : cleanest independence, but free tier is only
#     20 requests/day (a 25-item run needs ~15).
EVAL_JUDGE_PROVIDER=groq
EVAL_JUDGE_MODEL=openai/gpt-oss-20b
# Seconds to sleep between judge calls to stay under free-tier RPM limits.
EVAL_JUDGE_PACE_SECONDS=2.0

# --- MCP ---
# Unset MCP_SERVER_URL => the web app spawns the MCP server over stdio.
# Set it to have the web app connect to a standalone server over Streamable HTTP.
# MCP_SERVER_URL=http://127.0.0.1:8765/mcp
# Transport for the server process itself (stdio | streamable-http). The
# `python -m hr_agent.mcp_server --http` flag forces streamable-http regardless.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Agent<->tools loop cap. The demo workflows need <=4 tool calls.
MAX_TOOL_ITERATIONS=5
