# MCP service: the 9 policy/HR tools over Streamable HTTP. Private-network only
# (no public domain). The web service discovers its tools at runtime. See
# deployed.md.

FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-deps .

# the tools read the corpus (keyword search) and the mock data files
COPY corpus/ ./corpus/
COPY mock_data/ ./mock_data/

EXPOSE 8765
# --http => Streamable HTTP; host defaults to 0.0.0.0, port to $PORT.
CMD ["sh", "-c", "python -m hr_agent.mcp_server --http --port ${PORT:-8765}"]
